# この案件だけのファーム。値そのものは devicetree に置いてあり、
# ここにあるのは「その機能を積むかどうか」だけ。
#
# **同じ数字を 2 か所に書かない。**打ち止め電圧は
# hhkb_split.dtsi の empty-millivolts が唯一の出所で、
# tools/test_firmware.py が tools/circuit.py の BATT_V_MIN と突き合わせる。

config HHKB_BATTERY_ALKALINE
	bool "アルカリ乾電池の残量計"
	default y
	depends on DT_HAS_HHKB_BATTERY_ALKALINE_ENABLED
	select SENSOR
	select ADC
	help
	  ZMK 標準の残量計はリチウムイオンの放電曲線で % を出すため、
	  乾電池 2 本（2.4〜3.2V）ではほぼ常に 0% になる（open-gaps #13）。
	  こちらは分圧を読んで、使える電圧の窓の中での残りを % にする。

config HHKB_LOW_BATTERY_SOFT_OFF
	bool "打ち止め電圧を割ったら自分から止まる"
	default y
	depends on HHKB_BATTERY_ALKALINE && ZMK_PM_SOFT_OFF
	help
	  電池が尽きるとき、レールが落ちてブラウンアウト → 起動 → 広告 →
	  また落ちる、を繰り返す。残り少ない電池を早く使い切るうえ、
	  **低電圧での flash 書き込みでペアリング情報が壊れうる**
	  （nRF52840 の NVMC は VDD ≧ 1.7V が条件）。open-gaps #25b。

	  打ち止め（devicetree の empty-millivolts）を下回った状態が
	  HHKB_LOW_BATTERY_SOFT_OFF_SAMPLES 回続いたら soft off に入る。

config HHKB_STATUS_LED
	bool "XIAO 基板上の LED で状態を知らせる（実機の LED インジケーター相当）"
	default n
	depends on GPIO
	help
	  **新機能ではなく、欠落していた実機再現。**実機 HHKB Professional
	  HYBRID には前面に LED インジケーターがある（PFU 取扱説明書
	  P3PC-6641-05）。この案件はその事実を記録しておらず、
	  specs には「HHKB に存在しない機能」として RGB と並べて書いていた。
	  経緯は docs/hardware/decisions/2026-08-16-status-led.md。

	  実機の表をそのまま踏襲する:
	    消灯          接続中（**実機も接続中は消灯**）
	    青 1 秒に 2 回  ホストと繋がっていない（ペアリング待機相当）
	    橙 1 回/30 秒   電池残量が少ない
	    橙 2 回/15 秒   電池を交換
	    起動時         青点灯 → 消灯

	  **実機に無い状態を 1 つ足している。**完全分割型なので左手は
	  「右手と繋がっているか」も持つが、一体型の実機には対応が無い。
	  右手が落ちるとキーの半分が死ぬので、**緑**を当て、
	  **ホスト未接続より優先**する。

	  ⚠️ ZMK に「広告中」「スキャン中」の事象は無い（central.c の内部に
	  閉じている）。**「繋がっていない」を代理に使っている。**

	  ⚠️ led0/led1/led2 のエイリアスがある基板でしか積めない。
	  無ければ BUILD_ASSERT で落ちる（黙って無効にはしない）。

config HHKB_PROFILE_NAME
	bool "広告するデバイス名に登録先の番号を付ける（<名前>_1〜_4）"
	default n
	depends on ZMK_BLE && (ZMK_SPLIT_ROLE_CENTRAL || !ZMK_SPLIT)
	help
	  実機は「HHKB-Hybrid_n」（n = 登録先の数字キー）で広告し、
	  ホストの一覧で番号が見える（PFU 取扱説明書 P3PC-6641-05）。
	  ホストと話すのは左（セントラル）だけなので、右では積まない。

config HHKB_LOW_BATTERY_SOFT_OFF_SAMPLES
	int "何回続けて下回ったら止まるか"
	default 2
	range 1 255
	depends on HHKB_LOW_BATTERY_SOFT_OFF
	help
	  1 回で止めない。BLE 送信中の電圧降下（電池の内部抵抗 × 送信電流）で
	  一時的に下がることがあり、そこで落ちると誤動作に見える。
	  ZMK の測定間隔（ZMK_BATTERY_REPORT_INTERVAL・既定 60 秒）× この回数
	  だけ続いたら本物とみなす。

config HHKB_STICK_POD
	bool "スティックポッド（K 案・I2C で読むアナログスティック）"
	default y
	depends on DT_HAS_HHKB_STICK_POD_ENABLED
	select PM_DEVICE
	select I2C
	select ZMK_POINTING
	help
	  devicetree に hhkb,stick-pod があれば積む（ポッドを付ける側だけ）。

	  **I2C と ZMK_POINTING は select で引く。**.conf に書き忘れると
	  「ノードはあるのにドライバが入らない／右の入力が左へ届かない」が
	  ビルドは緑のまま起きるため（ZMK_INPUT_SPLIT は ZMK_POINTING の内側にある）。

	  PM_DEVICE も select で引く: ドライバが TWIM を自分で suspend/resume する
	  （pm_device_action_run は subsys/pm/device.c にあり、PM_DEVICE が無いと
	  リンクできない）。この案件は左右とも ZMK_SLEEP と ZMK_PM_SOFT_OFF で
	  すでに y。
	  PM_DEVICE_RUNTIME とは併用しない（ZMK の pm.c がリンクできなくなる）。
	  **ここに depends on !PM_DEVICE_RUNTIME とは書けない**: select ZMK_POINTING と
	  合わさって Kconfig の依存が輪になる（CI で確認）。stick_pod.c の BUILD_ASSERT で止める。

	  ⚠️ 左（セントラル）で ZMK_POINTING が新しく y になると **HID レポート
	  記述子が変わり、各ホストで登録し直しが要る。**いまは検討用マウスで
	  すでに y なので変わらない。

if HHKB_STICK_POD

# **既定の 500ms のままだと、SCL が Low に固定されたとき読み出しごとに
# 0.5 秒止まる。**モジュールの Kconfig は drivers/Kconfig より先に読まれるので
# （Kconfig.zephyr: modules/Kconfig → drivers/Kconfig）、ここの default が勝つ。
# 効いていなければ stick_pod.c の BUILD_ASSERT が落とす。
config I2C_NRFX_TRANSFER_TIMEOUT
	default 10

config HHKB_STICK_POD_STACK_SIZE
	int "ポーリングスレッドのスタック"
	default 2048
	help
	  **多めに取ってある（F15・未実測）。**I2C の読み出し、タイムアウト時の
	  バス復旧とそのログ、input_report、引数 8 個のログが同じスタックに乗る。
	  実機で CONFIG_THREAD_ANALYZER の最高水位を見てから削ること
	  （ボードは HW_STACK_PROTECTION=y なので、足りなければ壊れずに落ちる）。
	  このスレッドは I2C の読み出し・input_report・ログしかしない。
	  **settings への保存はシステムワークキューに回している**（NVS の
	  書き込みはスタックを食う）。

config HHKB_STICK_POD_THREAD_PRIORITY
	int "ポーリングスレッドの優先度（プリエンプティブ）"
	default 8
	range 0 14
	help
	  BLE のホスト／コントローラのスレッド（協調）とキースキャン
	  （システムワークキュー・協調 -1）、入力スレッド（ZMK は 0）より低く。
	  読み出しは 1.5ms ほどで、数 ms 遅れても困らない。

endif # HHKB_STICK_POD

config HHKB_BEHAVIOR_STICK_RECAL
	bool "スティックの中心を取り直すキー（&stick_recal）"
	default y
	depends on DT_HAS_HHKB_BEHAVIOR_STICK_RECAL_ENABLED
	help
	  **ポッドの無い側にも入る**（左右どちらのポッドにも 1 つのキーで
	  届かせるため。firmware/src/behavior_stick_recal.c の冒頭）。

config HHKB_ENCODER_GATED
	bool "止まっている間に電流を流さないロータリーエンコーダ（左手・B 案）"
	default y
	depends on DT_HAS_HHKB_ENCODER_GATED_ENABLED
	select SENSOR
	help
	  firmware/drivers/encoder_gated.c。追加シールド hhkb_enc_gated を重ねたときだけ入る。
