(module XIAO_nRF52840 (layer F.Cu) (tedit 0)
  (descr "Seeed Studio XIAO nRF52840. ピンソケットで挿すためのスルーホール版。ピン間隔は 0.6 インチ（15.24mm）で、基板の外形 17.8mm とは違う。実物をブレッドボードに挿して確認済み。")
  (tags "seeed xiao nrf52840 keyboard")
  (attr through_hole)
  (fp_text reference "U**" (at 0 -11) (layer F.SilkS) (effects (font (size 1 1) (thickness 0.15))))
  (fp_text value "XIAO_nRF52840" (at 0 11) (layer F.Fab) (effects (font (size 1 1) (thickness 0.15))))
  (pad "D0" thru_hole circle (at -7.62 -7.62) (size 1.7 1.7) (drill 1.0) (layers *.Cu *.Mask))
  (pad "D1" thru_hole circle (at -7.62 -5.08) (size 1.7 1.7) (drill 1.0) (layers *.Cu *.Mask))
  (pad "D2" thru_hole circle (at -7.62 -2.54) (size 1.7 1.7) (drill 1.0) (layers *.Cu *.Mask))
  (pad "D3" thru_hole circle (at -7.62 0.0) (size 1.7 1.7) (drill 1.0) (layers *.Cu *.Mask))
  (pad "D4" thru_hole circle (at -7.62 2.54) (size 1.7 1.7) (drill 1.0) (layers *.Cu *.Mask))
  (pad "D5" thru_hole circle (at -7.62 5.079999999999999) (size 1.7 1.7) (drill 1.0) (layers *.Cu *.Mask))
  (pad "D6" thru_hole circle (at -7.62 7.62) (size 1.7 1.7) (drill 1.0) (layers *.Cu *.Mask))
  (pad "5V" thru_hole circle (at 7.62 -7.62) (size 1.7 1.7) (drill 1.0) (layers *.Cu *.Mask))
  (pad "GND" thru_hole circle (at 7.62 -5.08) (size 1.7 1.7) (drill 1.0) (layers *.Cu *.Mask))
  (pad "3V3" thru_hole circle (at 7.62 -2.54) (size 1.7 1.7) (drill 1.0) (layers *.Cu *.Mask))
  (pad "D10" thru_hole circle (at 7.62 0.0) (size 1.7 1.7) (drill 1.0) (layers *.Cu *.Mask))
  (pad "D9" thru_hole circle (at 7.62 2.54) (size 1.7 1.7) (drill 1.0) (layers *.Cu *.Mask))
  (pad "D8" thru_hole circle (at 7.62 5.079999999999999) (size 1.7 1.7) (drill 1.0) (layers *.Cu *.Mask))
  (pad "D7" thru_hole circle (at 7.62 7.62) (size 1.7 1.7) (drill 1.0) (layers *.Cu *.Mask))
  (fp_line (start -8.9 -10.5) (end 8.9 -10.5) (layer F.Fab) (width 0.1))
  (fp_line (start 8.9 -10.5) (end 8.9 10.5) (layer F.Fab) (width 0.1))
  (fp_line (start 8.9 10.5) (end -8.9 10.5) (layer F.Fab) (width 0.1))
  (fp_line (start -8.9 10.5) (end -8.9 -10.5) (layer F.Fab) (width 0.1))
  (fp_line (start -9.15 -10.75) (end 9.15 -10.75) (layer F.CrtYd) (width 0.05))
  (fp_line (start 9.15 -10.75) (end 9.15 10.75) (layer F.CrtYd) (width 0.05))
  (fp_line (start 9.15 10.75) (end -9.15 10.75) (layer F.CrtYd) (width 0.05))
  (fp_line (start -9.15 10.75) (end -9.15 -10.75) (layer F.CrtYd) (width 0.05))
  (fp_line (start -4 -9.5) (end 4 -9.5) (layer F.SilkS) (width 0.3))
  (fp_text user "USB" (at 0 -7.6) (layer F.SilkS) (effects (font (size 0.8 0.8) (thickness 0.12))))
  (model "${KIPRJMOD}/lib/hhkb_split.3dshapes/XIAO_nRF52840.step"
    (offset (xyz 6.111 -1.804 0.165))
    (scale (xyz 1 1 1))
    (rotate (xyz -90 0 -90))
  )
)
