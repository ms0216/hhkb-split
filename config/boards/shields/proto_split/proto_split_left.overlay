/* 左（セントラル）。列 0・1 を使うので col-offset は不要。 */
#include "proto_split.dtsi"

/* ⚠️ [一時的] ログを UART（D6）へ。**電流を測るときは外す。**
 *
 * 2026-08-11: 上流の ZMK / Zephyr が動いたあと、CONFIG_SERIAL=n でも
 * この宣言があるだけで +0.47mA 乗る疑いが出た（同じ設定の昨日のビルドが
 * 0.43mA、今日のビルドが 0.90mA）。切り分けのため外してある。
 *
 * ログを読みたいときは、下の 2 ブロックを戻す。
 *
 * / {
 * 	chosen {
 * 		zephyr,console = &uart0;
 * 	};
 * };
 *
 * &uart0 {
 * 	status = "okay";
 * 	current-speed = <1000000>;
 * };
 */
