/*
 * Task C3: BLE 分割だけを切り出して確かめる治具。左右で共通の土台。
 *
 * 本番シールドは 74HC595 と 61 キーが前提なので、分割の検証には重すぎる。
 * ここではキースキャンを最も単純な直結（ダイオードもシフトレジスタも無し）に
 * して、**左右が無線でつながるかどうかだけ**を見る。
 *
 * 左 2 キー（a b）＋ 右 2 キー（c d）。配線は Task C1 とほぼ同じで、
 * スイッチの片側を D1・D2 へ、反対側を GND へ落とすだけ。
 *
 * BLE は当然 有効 のまま。ここで無効にしたら検証にならない。
 * （C1・C2 では変数を減らすために切っていたが、このタスクでは主役）
 *
 * **D0 はキーに使わない（2026-08-08）。** Task C5（電池残量）で D0 = AIN0 を
 * ADC に使うため。この治具は C4・C5 でも先に使うので、キーを D1・D2 へ寄せて
 * D0 を空けた。ADC が使えるのは D0..D5 だけで、本番シールドも同じ割り当て。
 */
#include <dt-bindings/zmk/matrix_transform.h>

/ {
	chosen {
		zmk,kscan = &kscan0;
		zmk,matrix-transform = &default_transform;
		zmk,battery = &vbatt;
	};

	/*
	 * 左右で 1 つの transform を共有し、右半分に col-offset を足す。
	 * ZMK の分割の標準的な書き方（本番シールドと同じ考え方）。
	 *
	 * 直結スキャンは 1 行 × N 列として扱われる。
	 *   左が列 0・1、右が列 2・3。
	 */
	default_transform: keymap_transform_0 {
		compatible = "zmk,matrix-transform";
		columns = <4>;
		rows = <1>;
		map = <
			RC(0,0) RC(0,1)   RC(0,2) RC(0,3)
		>;
	};

	kscan0: kscan_0 {
		compatible = "zmk,kscan-gpio-direct";
		wakeup-source;
		input-gpios
			= <&xiao_d 1 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>
			, <&xiao_d 2 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>
			;
	};

	/* Task C5: 電池電圧の測定。
	 * 分圧 1MΩ + 1MΩ を D0 (P0.02 = AIN0) で読む。測定点はショットキーの
	 * 手前（電池側）なので、USB 接続中も電池そのものの電圧が読める。
	 *
	 * ==================================================================
	 * ⚠️ **full-ohms を一時的に 2.5 倍にしてある（2026-08-09）。**
	 *    確認が済んだら 2000000 に戻す。**本番 hhkb_split.dtsi は 2MΩ のまま。**
	 * ==================================================================
	 *
	 * **理由: 2MΩ のままでは ADC が生きているか死んでいるか区別できない。**
	 *
	 * ZMK の残量 % はリチウムイオンの曲線で計算され、3450mV 以下は
	 * 一律 0% に潰れる（battery_common.c の lithium_ion_mv_to_pct）。
	 * 乾電池 2 本は 2.0〜3.2V なので**常に 0%**。
	 * **ADC が正しく 3.0V を読んでも、壊れて 0V を読んでも、同じ 0%。**
	 * 「0% が出た」は何も証明しない。
	 *
	 * ZMK は 電池電圧 = ADC 電圧 × full-ohms ÷ output-ohms で計算するので、
	 * 比を 2.5 倍にすると報告値が 0% に潰れない領域へ入る。
	 *
	 *   D0 の真の電圧  3.00 × 987/(976+987) = 1508mV（抵抗は実測値）
	 *   ZMK の計算値   1508 × 2.5           = 3771mV
	 *   表示される %   3771 × 2/15 − 459    = 43%
	 *
	 * **% から ADC の読みを逆算できる。**表示が P% なら
	 * ADC 電圧 = (P + 459) × 7.5 ÷ 2.5 で、分解能 3mV。テスターの入力抵抗
	 * 1MΩ に邪魔されずに読めるので、テスターより精密。
	 *
	 * 抵抗の実測値: R1 = 976kΩ / R2 = 987kΩ（±5% 以内なので本番は 1M/2M のまま）
	 */
	vbatt: vbatt {
		compatible = "zmk,battery-voltage-divider";
		io-channels = <&adc 0>;
		output-ohms = <1000000>;
		full-ohms = <2500000>;   /* [一時的] 確認後 2000000 へ戻す */
	};

};

&adc {
	status = "okay";
};
