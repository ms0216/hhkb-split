# スティックポッド（K 案）。**本体のシールドに重ねて使う追加シールド**
# （build.yaml で `shield: hhkb_split_right hhkb_pod_right` のように並べる）。
#
#   hhkb_pod_right   右にポッドを付ける    … **右のファーム**に重ねる
#   hhkb_pod_remote  右にポッドが付いている … **左のファーム**に重ねる（受け口）
#   hhkb_pod_left    左にポッドを付ける    … 左のファームに重ねる
#
# ⚠️ hhkb_pod_right と hhkb_pod_remote は必ず対。片方だけだと、右は動きを
#    送っているのに左が受け口を持たない（ビルドは両方とも緑）。
config SHIELD_HHKB_POD_LEFT
	def_bool $(shields_list_contains,hhkb_pod_left)

config SHIELD_HHKB_POD_RIGHT
	def_bool $(shields_list_contains,hhkb_pod_right)

config SHIELD_HHKB_POD_REMOTE
	def_bool $(shields_list_contains,hhkb_pod_remote)
