/*
 * Task C2 の判定表。overlay の map と同じ順に 30 個の文字を並べる。
 *
 *   出た文字   RC(row,col)   アノード側 → カソード側
 *   --------------------------------------------------
 *     a          RC(0,1)        D3 → D4
 *     b          RC(0,2)        D3 → D5
 *     c          RC(0,3)        D3 → D6
 *     d          RC(0,4)        D3 → D7
 *     e          RC(0,5)        D3 → D8
 *     f          RC(1,0)        D4 → D3
 *     g          RC(1,2)        D4 → D5
 *     h          RC(1,3)        D4 → D6
 *     i          RC(1,4)        D4 → D7
 *     j          RC(1,5)        D4 → D8
 *     k          RC(2,0)        D5 → D3
 *     l          RC(2,1)        D5 → D4
 *     m          RC(2,3)        D5 → D6
 *     n          RC(2,4)        D5 → D7
 *     o          RC(2,5)        D5 → D8
 *     p          RC(3,0)        D6 → D3
 *     q          RC(3,1)        D6 → D4
 *     r          RC(3,2)        D6 → D5
 *     s          RC(3,4)        D6 → D7
 *     t          RC(3,5)        D6 → D8
 *     u          RC(4,0)        D7 → D3
 *     v          RC(4,1)        D7 → D4
 *     w          RC(4,2)        D7 → D5
 *     x          RC(4,3)        D7 → D6
 *     y          RC(4,5)        D7 → D8
 *     z          RC(5,0)        D8 → D3
 *     1          RC(5,1)        D8 → D4
 *     2          RC(5,2)        D8 → D5
 *     3          RC(5,3)        D8 → D6
 *     4          RC(5,4)        D8 → D7
 *
 * 右欄は「読み取った規則が正しければこうなるはず」という**予測**であって、
 * 実測結果ではない。実測がこの表と食い違ったら規則の読み違いなので、
 * docs/hardware/task-c2-charlieplex.md に実測値を記録して map を作り直す。
 */
#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

/ {
	keymap {
		compatible = "zmk,keymap";

		default_layer {
			bindings = <
			&kp A &kp B &kp C &kp D &kp E
			&kp F &kp G &kp H &kp I &kp J
			&kp K &kp L &kp M &kp N &kp O
			&kp P &kp Q &kp R &kp S &kp T
			&kp U &kp V &kp W &kp X &kp Y
			&kp Z &kp N1 &kp N2 &kp N3 &kp N4
			>;
		};
	};
};
