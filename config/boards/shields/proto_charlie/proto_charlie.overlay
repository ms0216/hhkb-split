/*
 * Task C2: チャープレックスの「配線 → キー位置」対応を実測で確定させる治具。
 *
 * 本番（hhkb_split_left）と同じ 6 ピン D3..D8 を使う。違いは matrix-transform
 * だけで、こちらは 30 箇所**すべて**に別々の文字を割り当ててある。
 * スイッチを 1 つ配線して押せば、出てきた文字から RC(row,col) が一意に決まる。
 *
 * ZMK の実装から読み取った規則（app/module/drivers/kscan/kscan_gpio_charlieplex.c）:
 *   - gpios プロパティに書いた順が、そのまま添字 0,1,2,... になる
 *   - 走査は gpios[row] を OUTPUT HIGH で駆動し、gpios[col] を
 *     INPUT + PULL_DOWN（ACTIVE_HIGH のため）で読む
 *   - よって RC(row,col) は「gpios[row] から gpios[col] へ電流が流れる」キー
 *   - ダイオードはアノードが gpios[row] 側、カソード（帯）が gpios[col] 側
 *
 * この規則が正しいことを実機で確かめるのがこのシールドの目的。
 * 読み違えたまま基板を発注すると 42 キー全部が入れ替わる。
 */
#include <dt-bindings/zmk/matrix_transform.h>

/ {
	chosen {
		zmk,kscan = &kscan0;
		zmk,matrix-transform = &charlie_transform;
	};

	/*
	 * 添字と基板シルクの対応:
	 *   0=D3  1=D4  2=D5  3=D6  4=D7  5=D8
	 */
	kscan0: kscan_0 {
		compatible = "zmk,kscan-gpio-charlieplex";
		wakeup-source;
		gpios
			= <&xiao_d 3 GPIO_ACTIVE_HIGH>
			, <&xiao_d 4 GPIO_ACTIVE_HIGH>
			, <&xiao_d 5 GPIO_ACTIVE_HIGH>
			, <&xiao_d 6 GPIO_ACTIVE_HIGH>
			, <&xiao_d 7 GPIO_ACTIVE_HIGH>
			, <&xiao_d 8 GPIO_ACTIVE_HIGH>
			;
	};

	/*
	 * 30 箇所を row 昇順・col 昇順（row==col は不可なので飛ばす）で並べる。
	 * キーマップ側は同じ順に a..z 1..4 を並べてあるので、
	 *   出た文字 → この表の何番目 → RC(row,col)
	 * が一意に逆引きできる。
	 */
	charlie_transform: keymap_transform_0 {
		compatible = "zmk,matrix-transform";
		columns = <6>;
		rows = <6>;
		map = <
			RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5)
			RC(1,0) RC(1,2) RC(1,3) RC(1,4) RC(1,5)
			RC(2,0) RC(2,1) RC(2,3) RC(2,4) RC(2,5)
			RC(3,0) RC(3,1) RC(3,2) RC(3,4) RC(3,5)
			RC(4,0) RC(4,1) RC(4,2) RC(4,3) RC(4,5)
			RC(5,0) RC(5,1) RC(5,2) RC(5,3) RC(5,4)
		>;
	};
};
