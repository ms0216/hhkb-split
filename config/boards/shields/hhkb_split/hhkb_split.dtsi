/*
 * 左右で共通の土台。
 *
 * キースキャンは「ごく普通の行×列マトリクス＋キーごとにダイオード1個」。
 * 列を駆動するピンが足りないぶんはシフトレジスタ 595（SN74LVC595A）で作る。
 * ZMK 公式が「標準マトリクスでピンが足りない場合の推奨手段」としている方式。
 *   https://zmk.dev/docs/development/hardware-integration/shift-registers
 *
 * 【重要】当初はチャープレックス（zmk,kscan-gpio-charlieplex）で設計していたが、
 * 基板発注前に破棄した。理由は docs/hardware/decisions/2026-08-07-keyscan.md。
 * 要点だけ書くと、nRF52840 の 3.3V ではダイオードの電圧降下だけで
 * ゴースト（2キー同時押しで押していないキーが誤検出される現象）を消せない。
 * 入力の閾値が VDD の 0.7 倍と 0.3 倍なので、
 *   本物のキー（ダイオード1個）を HIGH と読ませるには Vf <= 0.99V
 *   ゴースト（ダイオード2個）を LOW と読ませるには Vf >= 1.155V
 * となり両立しない。乾電池で VDD が下がるとさらに条件が動く。
 * Shift・Ctrl・Fn との同時押しは常用するので、この方式は採れない。
 *
 * ------------------------------------------------------------------
 * ピンの割り当て（XIAO nRF52840、使えるのは D0..D10 の 11 本）
 *
 *   D0        電池電圧の測定（ADC が使えるのは D0..D5 だけなので D0 を使う）
 *   D1        予備。**わざと空けている**（2026-08-14・#41）。D0 と行の間に
 *             1 ピンぶんの隙間を作ると、子基板の奥側が 2.54mm 空き、
 *             分圧抵抗の置き場所になる（利用者の指摘）
 *   D2..D6    行 0..4。MCU に直結した「入力」。**5 本とも左列**
 *   D7        シフトレジスタの CS（ラッチ）
 *   D8        SPI SCK   ─┐ xiao_spi (= spi2) が使う
 *   D9        予備（**元は SPI MISO**。board 定義のまま触らない）
 *   D10       SPI MOSI  ─┘
 *
 * **2026-08-14 に行を D1..D4+D9 から D2..D6 へ移した**（#41）。
 * 以前は ROW4 だけ右列の D9 にあり、MISO を pinctrl から外して GPIO に
 * 転用していた。理由は「左列のレーンが 6 本だとアンテナの真下を 2 本が
 * 通る」（#23）。**その 6 本目は VBATT_SENSE だった。**分圧を子基板へ
 * 移して FFC を渡らなくなったので、行 5 本を左列に戻しても 5 本のまま。
 * → **MISO の上書きが不要になり、削除した**（下の注記）。
 *
 * ZMK の公式サンプルは CS に D9（MISO）を充てているが、xiao_ble の pinctrl は
 * P1.14 を MISO として確保している（zephyr の xiao_ble-pinctrl.dtsi）。
 * 競合を避けるため、こちらは D7 を CS にした。
 *
 * ------------------------------------------------------------------
 * 行と列は物理配列そのまま。5 段 × 左 6 列 / 右 9 列。
 *
 * 右半分の最上段は 9 キーあるので 9 列必要。595 は 8 出力なので
 * **右は 2 個を数珠つなぎ**にする（ngpios = 16、うち 9 本を使う）。
 *
 * 当初は ` 1 つを最下段の空き（row4, col3）へ回して 8 列に収め、595 を
 * 1 個で済ませていた。だが基板を起こしたところ、物理的には最上段にある
 * キーが論理的に最下段になるため、**90mm の配線が 4 段ぶんのスイッチを
 * 横切る**羽目になった。DRC が交差と短絡として検出した。
 * 部品を 1 個（30 円）足す方が、配線の素直さに見合う。
 */
#include <dt-bindings/zmk/matrix_transform.h>

/ {
	chosen {
		zmk,kscan = &kscan0;
		zmk,matrix-transform = &default_transform;
	};

	/*
	 * 左右で「1 つの」transform を共有する。これが ZMK の分割の標準的な書き方で、
	 * 右半分は overlay で col-offset = <6> を足して、この表の右側へ写す。
	 *
	 * 当初は左右で別々の transform を定義していたが、これは非標準で、
	 * 右半分のキー位置がずれる恐れがあった。corne など公式シールドの
	 * 書き方に合わせて作り直した。
	 *
	 * 全体は 5 行 × 15 列。左が列 0..5、右が列 6..14
	 * （下の columns = <15> と、map の RC(0,14) が正）。
	 *
	 * 並び順はキーマップの 61 バインディングと一対一で対応する
	 * （左 27 を上段左から、続いて右 34 を上段左から）。
	 */
	default_transform: keymap_transform_0 {
		compatible = "zmk,matrix-transform";
		columns = <15>;
		rows = <5>;
		map = <
		/* --- 左 27 --- */
		/* Esc 1 2 3 4 5                      */ RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5)
		/* Tab Q W E R T                      */ RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5)
		/* Ctrl A S D F G                     */ RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5)
		/* Shift Z X C V B                    */ RC(3,0) RC(3,1) RC(3,2) RC(3,3) RC(3,4) RC(3,5)
		/* Alt Meta L-Space                   */ RC(4,1) RC(4,3) RC(4,5)

		/* --- 右 34 --- */
		/* 6 7 8 9 0 - = \ `                  */ RC(0,6) RC(0,7) RC(0,8) RC(0,9) RC(0,10) RC(0,11) RC(0,12) RC(0,13) RC(0,14)
		/* Y U I O P [ ] Del                  */ RC(1,6) RC(1,7) RC(1,9) RC(1,10) RC(1,11) RC(1,12) RC(1,13) RC(1,14)
		/* H J K L ; ' Enter                  */ RC(2,7) RC(2,8) RC(2,9) RC(2,10) RC(2,11) RC(2,12) RC(2,13)
		/* N M , . / Shift Fn                 */ RC(3,7) RC(3,8) RC(3,9) RC(3,10) RC(3,11) RC(3,13) RC(3,14)
		/* R-Space Meta Alt                   */ RC(4,8) RC(4,10) RC(4,11)
		>;
	};

	/*
	 * 行は MCU のピンに直結した入力にする。これは公式ドキュメントの指示で、
	 * 「入力を MCU 直結にしておくと割り込みで起こせる ＝ 常時スキャンせずに済み、
	 * 電池が持つ」ため。シフトレジスタは列（出力）側にだけ使う。
	 *
	 * col2row はダイオードのアノードが列側、カソードが行側という意味。
	 */
	kscan0: kscan_0 {
		compatible = "zmk,kscan-gpio-matrix";
		wakeup-source;
		diode-direction = "col2row";
		/*
		 * **並びは行 0..4 の順。ピン番号の順ではない**（2026-08-14・#41）。
		 *
		 *   行 0 → D2 / 行 1 → **D6** / 行 2 → **D3** / 行 3 → **D4** / 行 4 → **D5**
		 *
		 * **並びは利用者の指定**（2026-08-14）「D3 = ROW2 が最も外周側」。
		 * D3/D4/D5 を XIAO のパッド列の外側に通し、パッドから伸びる
		 * 水平線を **D3 が最長・D5 が最短**にする。
		 *
		 *   D3 = ROW2（最も外周）/ D4 = ROW3 / D5 = ROW4 / D6 = ROW1（内側）
		 *
		 * ⚠️ **これは長らく絵に描いた餅だった。**この並び自体は前から
		 * あったが、配線後の基板を実測すると列の外へ出ていたのは 2 本
		 * だけで、ROW3/ROW4 は x=-7.62（パッド）で止まり、内側にいる
		 * はずの ROW0 が外周を取っていた。**自動配線器はこの計画を
		 * 知らない。**`gen_daughterboard._prewire_rows` で自分で引く
		 * ようにして、ようやく実現した（実測 -10.10/-9.70/-9.30・
		 * 交差 0・折れ 3 回）。
		 *
		 * **FFC の並びは動かしていない。**主基板の行バスの都合で決まって
		 * いるので、XIAO 側だけ変えれば主基板は無傷（利用者の指摘）。
		 * 順序のズレは配線でひねらず**ここで吸収する。**
		 *
		 * ⚠️ **circuit.py の XIAO のピン割り当てと 1 対 1 で対応する。**
		 * 片方だけ直すと、押したキーと違う行が読まれる。
		 */
		row-gpios
			= <&xiao_d 1 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
			, <&xiao_d 3 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
			, <&xiao_d 2 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
			, <&xiao_d 5 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
			, <&xiao_d 6 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
			;
	};
};

/*
 * **`&spi2_default` の上書きは 2026-08-14 に削除した**（open-gaps #41）。
 *
 * ここには「D9（P1.14）を SPI の MISO から解放する」上書きがあった。
 * 行 4 を D9 に置いていたため、pinctrl から MISO を外して GPIO として
 * 使う必要があったから。
 *
 * **行が D2〜D6（左列）へ戻ったので、D9 を GPIO に転用しなくなった。**
 * 分圧を子基板へ移して VBATT_SENSE が FFC を渡らなくなり、左列のレーンが
 * 空いたのが理由（#41）。board 定義の pinctrl をそのまま使えばよい。
 */

/*
 * シフトレジスタ。SPI 経由で列を駆動する。
 * ngpios は 595 の出力本数。**ここの既定は左向けの 8**（左は 6 列なので
 * 1 個で足りる）。**右は overlay で 16 に上書きする**（9 列必要で、
 * 2 個を数珠つなぎ／hhkb_split_right.overlay）。
 */
&xiao_spi {
	status = "okay";
	cs-gpios = <&xiao_d 7 GPIO_ACTIVE_LOW>;

	shifter: 595@0 {
		compatible = "zmk,gpio-595";
		status = "okay";
		gpio-controller;
		/* 200kHz は保守的すぎた。**数珠つなぎの 595 は速い打鍵を
		 * 取りこぼす例が ZMK 公式に報告されている。**
		 * 595（SN74LVC595A）は 3.3V でも 20MHz 級まで動く。4MHz なら
		 * 16bit の転送が 4µs で終わり、スキャン周期に対して無視できる。
		 * Task C2-b で実測して詰める。 */
		spi-max-frequency = <4000000>;
		reg = <0>;
		#gpio-cells = <2>;
		ngpios = <8>;
	};
};

/ {
	/* 電池電圧の測定。分圧 1MΩ + 1MΩ を D0 (P0.02 = AIN0) で読む。
	 *
	 * 回路は tools/circuit.py が唯一の出所。分圧は**スライドスイッチの後ろ・
	 * ショットキーの手前**に置いてあるので、USB 接続中も電池そのものの
	 * 電圧が読める。
	 *
	 * **残量%は乾電池用に差し替えてある**（open-gaps #13）。
	 * ZMK 標準（zmk,battery-voltage-divider）はリチウムイオンの放電曲線で
	 * 3.45V 以下を 0% とするので、乾電池 2 本ではほぼ常に 0% になる。
	 * firmware/drivers/battery_alkaline.c が、下の 2 つの電圧の間での
	 * 残りを % にする。
	 *
	 * **この 2 つの数字の出所は tools/circuit.py だけ。**
	 *   empty = BATT_V_MIN  … この回路が動かなくなる電圧
	 *                         （マイコン・595・マトリクス・ソケットの
	 *                           下限のうち最も厳しいもの ＋ ショットキー Vf）
	 *   full  = BATT_V_MAX  … 新品のアルカリの開路電圧（1.65V × 2）
	 * tools/test_firmware.py が両方を突き合わせ、ずれたら落ちる。
	 */
	/*
	 * ⚠️ **このノードはボード側の vbatt と合体する**（同じパス・同じラベル）。
	 * xiao_ble//zmk の xiao_ble_zmk.dts が
	 *
	 *   vbatt: vbatt {
	 *       io-channels = <&adc 7>;                 ← XIAO 内蔵の分圧
	 *       power-gpios = <&gpio0 14 (OPEN_DRAIN | ACTIVE_LOW)>;
	 *       output-ohms = <510000>; full-ohms = <1510000>;
	 *   };
	 *
	 * を持っており、上書きしない性質は**そのまま残る**。
	 *
	 * **2026-08-11 に発覚: power-gpios を受け継いだままだった。**
	 * P0.14 は **XIAO 内蔵**の分圧（AIN7）を有効にするピンで、こちらは
	 * D0/AIN0 の**外付け** 1MΩ+1MΩ を常時つないでいるので要らない。
	 * それなのに ZMK は電池を測るたびに P0.14 を叩き、**10ms 待って**いた
	 * （driver の「容量が充電されるのを待つ」処理）。60 秒ごとに 10ms、
	 * 使っていない回路のために起きていたことになる。
	 * 残量計を差し替えたときに devicetree の検査が
	 * 「宣言されていない property がある」と言って気づかせてくれた。
	 */
	vbatt: vbatt {
		compatible = "hhkb,battery-alkaline";
		io-channels = <&adc 0>;
		output-ohms = <1000000>;
		full-ohms = <2000000>;
		empty-millivolts = <2400>;
		full-millivolts = <3300>;
		/delete-property/ power-gpios;
	};

	chosen {
		zmk,battery = &vbatt;
	};
};

&adc {
	status = "okay";
};
