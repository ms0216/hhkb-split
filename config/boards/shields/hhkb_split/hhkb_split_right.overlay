/*
 * 右半分（34 キー）。分割の周辺側（ペリフェラル）。
 *
 * 列は 9 本。595（SN74LVC595A）は 8 出力なので 2 個を数珠つなぎにして出力 0..8 を使う
 * （ngpios = 16）。最上段が 9 キーあるため。
 * 右半分の基板上では列 0..7 だが、キーマップ全体では列 6..13 に当たるので、
 * col-offset で 6 だけずらす。これが ZMK の分割の標準的な書き方。
 */
#include "hhkb_split.dtsi"

&default_transform {
	col-offset = <6>;
};

/* 右だけ 595 を 2 個つなぐ。数珠つなぎのぶん取りこぼしやすくなるので、
 * 速い打鍵での確認を Task C2-b の重点項目にしている。 */
&shifter {
	ngpios = <16>;
};

&kscan0 {
	col-gpios
		= <&shifter 0 GPIO_ACTIVE_HIGH>
		, <&shifter 1 GPIO_ACTIVE_HIGH>
		, <&shifter 2 GPIO_ACTIVE_HIGH>
		, <&shifter 3 GPIO_ACTIVE_HIGH>
		, <&shifter 4 GPIO_ACTIVE_HIGH>
		, <&shifter 5 GPIO_ACTIVE_HIGH>
		, <&shifter 6 GPIO_ACTIVE_HIGH>
		, <&shifter 7 GPIO_ACTIVE_HIGH>
		, <&shifter 8 GPIO_ACTIVE_HIGH>
		;
};

	/*
	 * **J_DB から遠い行ほど、J_DB のパッド列で「板の内側」の枠へ**
	 * （2026-08-15・利用者の指摘で組み直した）。考え方は左基板と同じ。
	 *
	 * ただし**右基板の J_DB は板の左端**にあり、**12 番(ROW_E) の x が
	 * 最小＝板端寄り**で、左とは意味が逆。したがって並びも逆になる。
	 *
	 *   J_DB からの距離: 行4 56.4 > 行3 37.3 > 行0 19.8 > 行2 18.3 > 行1 0.8
	 *   → 行4=ROW_A / 行3=ROW_B / 行0=ROW_C / 行2=ROW_D / 行1=ROW_E
	 *
	 * **この向きで未配線 0**（逆向きだと 3 本残った。実測・2026-08-15）。
	 *
	 * ⚠️ **左基板とは違う並びになる。**揃えようとしないこと。
	 */
&kscan0 {
	row-gpios
		= <&xiao_d 3 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
		, <&xiao_d 1 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
		, <&xiao_d 2 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
		, <&xiao_d 6 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
		, <&xiao_d 5 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
		;
};
