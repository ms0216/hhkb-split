# KiCad
*-backups/
*.kicad_prl
fp-info-cache
*.bak
*.kicad_pcb-bak
*.kicad_sch-bak
*.net
_autosave-*

# KiCad 出力（生成物。必要なら release/ に手動でコピーする）
gerbers/
*.gbr
*.drl
*.zip

# CAD
*.f3d~
*.step~

# Python
.venv/
__pycache__/
.pytest_cache/

# 生成物（スクリプトから再生成できるため管理しない）
build/

# OS
.DS_Store
Thumbs.db

# スライス結果(容量が大きいので管理しない)
build/slice/

# SDD の作業場所（この計画かぎりの一時ファイル）
.superpowers/

# エディタの Local History（pcb/.history/ に自動生成される）
.history/

# KiCad が開いている間だけできるロックファイル。**コミットしてはいけない。**
# git add -A で 2 回巻き込んだ（2026-08-10）。触ったファイルだけを名指しで stage する
~*.lck

# 試しの配線の置き場（本番と別に出すためのもの・成果物ではない）
#   pcb/try/    … autoroute.py --out で出す私の実験
#   pcb/matrix/ … 利用者が KiCad で手を入れる実験用
# **成果物は pcb/matrix_only/**（キーマトリクスだけを引いた基板）。
pcb/try/
pcb/matrix/

# 発注ごとに作る製造ファイル（ガーバー・BOM・CPL）。生成物で再現できる。
pcb/production/
